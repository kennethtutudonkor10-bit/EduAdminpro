# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# All /api/* routes require authentication: either a user session (obtained via
# POST /api/auth/login) or the shared machine key below.

# EDUADMIN_ADMIN_USERNAME / EDUADMIN_ADMIN_PASSWORD: Seed the first administrator
# on a fresh database. If unset, a default "admin" account is created with a
# temporary password (admin123) that MUST be changed on first login.
# EDUADMIN_ADMIN_USERNAME="admin"
# EDUADMIN_ADMIN_PASSWORD="choose-a-strong-password"

# EDUADMIN_API_KEY: Shared machine key for non-interactive clients (e.g. the
# Android companion app), sent as the X-EduAdmin-Key header. Grants service-level
# access to /api/*. Can also be stored as the `api_key` setting.
# EDUADMIN_API_KEY="choose-a-strong-key"

# EDUADMIN_ENCRYPTION_KEY: Secret used to encrypt contact PII (phone numbers,
# photos, email) at rest with AES-256-GCM. Strongest option — keep it out of the
# data directory (e.g. an OS keychain / secret manager). If unset, a key file is
# generated in the data directory (protects an exfiltrated DB, but not full-disk
# access). Changing this key makes previously-encrypted values unreadable.
# EDUADMIN_ENCRYPTION_KEY="choose-a-long-random-secret"

# HOST: Bind address for the server. Defaults to 0.0.0.0 (LAN-accessible) for
# standalone mode. The packaged Electron app sets this to 127.0.0.1 automatically.
# HOST="0.0.0.0"
